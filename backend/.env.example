# Vision provider selection: "anthropic", "openai", or "gemini".
VISION_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Leave this blank/unset to omit the `reasoning` param entirely - a
# non-reasoning model 400s on it.
OPENAI_REASONING_EFFORT=low

# --- Gemini ---
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as a fallback if GEMINI_API_KEY is unset.
GOOGLE_API_KEY=
# Comma-separated fallback chain, tried in order on transient errors
# (503/UNAVAILABLE/429/RESOURCE_EXHAUSTED/"overloaded").
GEMINI_MODEL=gemini-3.7-flash,gemini-3.8-flash,gemini-3.6-flash
# Quirk: Gemini's schema normalizer only marks a field "required" if it has
# no Python default, so it can legitimately omit optional fields like
# raw_protein_detected from its required list (Pydantic fills False on the
# way back out). This only weakens the free-form protein warning on Gemini -
# the recipe-driven safety override main.py enforces is unaffected.

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# HTTPS listener for phones on the same Wi-Fi (start.sh / start.ps1). The cert
# itself comes from scripts/lan.py, not from a path in this file.
BACKEND_HTTPS_PORT=8443

# --- Demo mode ---
# DEMO_MODE=true serves a cached fixture from data/demo_fixtures/ when one
# matches, but still falls through to a live call on a miss.
DEMO_MODE=false
# DEMO_STRICT=true makes a fixture miss return a canned response instead of
# falling through to a live call - required for a genuinely offline run.
DEMO_STRICT=false

# --- Tablet bring-up ---
# Two ways to reach this backend from a tablet:
#   1. `adb reverse tcp:8000 tcp:8000` (Android, over USB) - no certificates,
#      no network config, the tablet just talks to localhost:8000. Preferred.
#   2. Self-signed HTTPS - needed for iOS or a tablet not on USB, but then
#      getUserMedia/wakeLock require a certificate the browser trusts enough,
#      and it will nag on every load. Only use this if adb reverse isn't an
#      option.

# --- Object + hand detection (installed by ./setup.sh unless --no-detection) ---
# Powers POST /detect and the on-screen detection preview. Pretrained models only - nothing
# is trained. The values below are the measured winner on the reference laptop; re-run
# scripts/benchmark_detectors.py on other hardware (data/benchmarks/detector_report.md).
# ./setup-window.sh turns detection on for its run regardless of this setting.
DETECTION_ENABLED=false
DETECTOR_MODEL=yoloe-26s-seg
DETECTOR_IMGSZ=480
DETECTOR_FORMAT=openvino
DETECTOR_CONF=0.25
# true: each frame is letterboxed to its own shape (16:9 -> 480x288) instead of a padded square -
# same resolution, 24-42% less work measured. false = the square export used by the benchmark.
DETECTOR_RECT=true
# hybrid (measured best) = MediaPipe hands with fingertips + detector hands MediaPipe missed;
# mediapipe = fingertip landmarks only; detector = the model's own hand boxes; none
HANDS_BACKEND=hybrid

# --- Voice and typed commands (/voice/text, /voice) ---
# Understanding a command needs any one key above: OpenAI (VOICE_MODEL, default gpt-5-mini) is
# used when set, else the VISION_PROVIDER's, else whichever key exists. Set VOICE_PROVIDER to
# pick one explicitly. Recorded audio (browsers without speech recognition) needs OPENAI_API_KEY.
# VOICE_PROVIDER=gemini
# GEMINI_VOICE_MODEL defaults to the GEMINI_MODEL chain; GEMINI_VOICE_THINKING=low (blank = model default).
# GEMINI_VOICE_MODEL=gemini-3.7-flash,gemini-3.8-flash,gemini-3.6-flash
# GEMINI_VOICE_THINKING=low
# ANTHROPIC_VOICE_MODEL defaults to ANTHROPIC_MODEL.
# ANTHROPIC_VOICE_MODEL=

# --- Recipe database ---
# SQLite file, created and seeded from data/recipes.json on first start - and re-seeded when
# that file changes (new curated recipes after a git pull). Staged imports are never touched. Gitignored.
# DB_PATH=data/cook.db

# --- Pairing token (opt-in) ---
# Blank/unset (the default) leaves every route unauthenticated - unchanged
# behavior. Set this only when the backend is reachable from more than the
# USB-tethered tablet (e.g. self-signed HTTPS on a LAN) and you want to
# require a shared secret on every real request. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
BACKEND_PAIRING_TOKEN=
